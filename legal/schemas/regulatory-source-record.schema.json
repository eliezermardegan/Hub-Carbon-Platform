{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regulatory source record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "jurisdiction",
    "publisher",
    "title",
    "officialUrl",
    "status",
    "retrievedAt",
    "reuseNotes"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "const": "EU"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "instrumentId": {
      "type": "string"
    },
    "officialUrl": {
      "type": "string",
      "format": "uri"
    },
    "publicationDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "entryIntoForceDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "applicationDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "consolidatedAsOf": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "pinpoint": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "catalogued",
        "needs-legal-review",
        "approved-for-implementation",
        "historical-test-only",
        "superseded"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersededBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reuseNotes": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
